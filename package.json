{
  "name": "constructinator",
  "version": "0.1.0",
  "description": "Combine up to six chat exports into one new AI persona and render it as a Soul Pack. Bring your own OpenRouter key and pick any model. Inspired by Project Capricorn (Capri) from Cyberpunk: Edgerunners 2.",
  "keywords": [
    "persona",
    "ai-persona",
    "personality",
    "psyche",
    "chat-analysis",
    "whatsapp",
    "line",
    "openrouter",
    "llm",
    "nextjs",
    "soul-pack",
    "project-capricorn",
    "capri",
    "cyberpunk-edgerunners"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivianpratama/Constructinator.git"
  },
  "homepage": "https://github.com/rivianpratama/Constructinator#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:baseline": "tsx scripts/sync-baseline.ts",
    "sync:vendor": "tsx scripts/sync-baseline.ts",
    "try:irisesweb": "bash scripts/try-in-irisesweb.sh",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
